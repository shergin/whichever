file: macros/src/partial.rs
breaks: A macro invocation in a partial impl block is reported, since the items it writes cannot be told from the ones to forward, as `docs/limits.md` and `docs/partial-impl-blocks.md` say.
expect: killed
witness: path=block-macro

find:
        ImplItem::Macro(invocation) => Err(unread_invocation(invocation)),
replace:
        ImplItem::Macro(invocation) if false => Err(unread_invocation(invocation)),
