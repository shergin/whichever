file: macros/src/forwarding.rs
breaks: Every token of a forwarded method carries the subject's span, so that no error lands on the trait's attribute, as `macros/ARCHITECTURE.md` 3.8 says.
expect: killed

find:
        way_out,
        declared,
        site,
    };
replace:
        way_out,
        declared,
        site: match origin {
            Origin::Trait { .. } => Site::at(Span::call_site()),
            Origin::Inherent { .. } => site,
        },
    };
